# Secret issued by CurseForge. Never commit the real value.
CURSEFORGE_API_KEY=replace_me

# Optional lightweight gate for MCW Launcher requests.
# This token is not a strong secret once embedded in a desktop app.
# Leave empty to expose the validated gateway endpoints publicly.
MCW_CLIENT_TOKEN=

# Optional browser origin. Desktop clients do not require CORS.
# Example: https://mahiru7229.github.io
MCW_ALLOWED_ORIGIN=*

# Optional overrides.
CURSEFORGE_API_BASE_URL=https://api.curseforge.com/v1
CURSEFORGE_TIMEOUT_MS=12000
