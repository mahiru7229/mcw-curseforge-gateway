# Secret issued by CurseForge. Never commit the real value.
CURSEFORGE_API_KEY=replace_me

# Optional lightweight gate for MCW Launcher requests.
# This token is not a strong secret once embedded in a desktop app.
# Leave empty to expose the validated gateway endpoints publicly.
MCW_CLIENT_TOKEN=

# Optional browser origin. Desktop clients do not require CORS.
# Example: https://mahiru7229.github.io
MCW_ALLOWED_ORIGIN=*

# Optional overrides.
CURSEFORGE_API_BASE_URL=https://api.curseforge.com/v1
CURSEFORGE_TIMEOUT_MS=12000

# Gateway-side sliding-window rate limit. Enabled by default.
MCW_RATE_LIMIT_ENABLED=true
MCW_RATE_LIMIT_REQUESTS=60
MCW_RATE_LIMIT_GLOBAL_REQUESTS=600
MCW_RATE_LIMIT_WINDOW_SECONDS=60

# Recommended for Vercel: connect an Upstash Redis database and use the
# automatically injected UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN.
# These MCW-prefixed names can be used as explicit overrides.
MCW_RATE_LIMIT_REDIS_REST_URL=
MCW_RATE_LIMIT_REDIS_REST_TOKEN=
